---
import '@fontsource-variable/inter';
import '@fontsource-variable/plus-jakarta-sans';
import '@fontsource-variable/jetbrains-mono';
---
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="alternate" type="application/rss+xml" title="M9G (Minsu Chang / mincasurong) RSS Feed" href="https://mincasurong.github.io/rss.xml" />
<script is:inline>
  (function() {
    var t = 'light';
    try {
      if (localStorage.getItem('m9g_theme') === 'dark') t = 'dark';
    } catch (e) {}
    var root = document.documentElement;
    root.classList.remove('light', 'dark');
    root.classList.add(t);
    root.dataset.theme = t;
    root.style.colorScheme = t;
    window.__m9gToggleTheme = function() {
      var next = root.classList.contains('dark') ? 'light' : 'dark';
      root.classList.remove('light', 'dark');
      root.classList.add(next);
      root.dataset.theme = next;
      root.style.colorScheme = next;
      try { localStorage.setItem('m9g_theme', next); } catch (e) {}
      document.querySelectorAll('[data-theme-toggle]').forEach(function(btn) {
        var mode = btn.getAttribute('data-theme-toggle');
        if (mode === 'icon-only') {
          btn.textContent = next === 'light' ? '☀' : '☾';
        } else {
          btn.textContent = next === 'light' ? '☀ Light' : '☾ Dark';
        }
      });
    };
    window.addEventListener('DOMContentLoaded', function() {
      var cur = root.classList.contains('dark') ? 'dark' : 'light';
      document.querySelectorAll('[data-theme-toggle]').forEach(function(btn) {
        var mode = btn.getAttribute('data-theme-toggle');
        if (mode === 'icon-only') {
          btn.textContent = cur === 'light' ? '☀' : '☾';
        } else {
          btn.textContent = cur === 'light' ? '☀ Light' : '☾ Dark';
        }
      });
    });
  })();
</script>
