    <script is:inline define:vars={{ PORTAL_I18N: portalI18nMap }}>
      (function () {
        var STORAGE_KEY = 'm9g_portfolio_lang';
        var switcherBtn = document.getElementById('lang-switcher-btn');
        var switcherLabel = document.getElementById('lang-switcher-label');
        var switcherMenu = document.getElementById('lang-switcher-menu');
        var optionBtns = document.querySelectorAll('[data-lang-option]');

        function applyLocale(lang) {
          var dict = PORTAL_I18N[lang] || PORTAL_I18N.en;
          var resolved = PORTAL_I18N[lang] ? lang : 'en';
          document.documentElement.lang = resolved;
          if (switcherLabel) {
            switcherLabel.textContent = resolved.toUpperCase();
          }
          optionBtns.forEach(function (btn) {
            btn.classList.toggle('active', btn.getAttribute('data-lang-option') === resolved);
          });
          document.querySelectorAll('[data-i18n]').forEach(function (el) {
            if (el.dataset.origHtml === undefined) {
              el.dataset.origHtml = el.innerHTML;
            }
            if (resolved === 'en') {
              if (el.innerHTML !== el.dataset.origHtml) {
                el.innerHTML = el.dataset.origHtml;
              }
              return;
            }
            var key = el.getAttribute('data-i18n');
            if (!key || !(key in dict)) return;
            var val = dict[key];
            if (key.slice(-4) === 'Html') {
              el.innerHTML = val;
            } else {
              el.textContent = val;
            }
          });
          try {
            localStorage.setItem(STORAGE_KEY, resolved);
          } catch (e) {}
        }

        var initialLang = 'en';
        try {
          var saved = localStorage.getItem(STORAGE_KEY);
          if (saved && PORTAL_I18N[saved]) initialLang = saved;
        } catch (e) {}
        applyLocale(initialLang);

        if (switcherBtn && switcherMenu) {
          switcherBtn.addEventListener('click', function (ev) {
            ev.stopPropagation();
            var isOpen = switcherMenu.classList.toggle('open');
            switcherBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
          });
          optionBtns.forEach(function (btn) {
            btn.addEventListener('click', function () {
              var code = btn.getAttribute('data-lang-option') || 'en';
              applyLocale(code);
              switcherMenu.classList.remove('open');
              switcherBtn.setAttribute('aria-expanded', 'false');
            });
          });
          document.addEventListener('click', function (ev) {
            if (!switcherMenu.contains(ev.target) && ev.target !== switcherBtn) {
              switcherMenu.classList.remove('open');
              switcherBtn.setAttribute('aria-expanded', 'false');
            }
          });
        }

        var whyBtn = document.getElementById('why-m9g-btn');
        var popup = document.getElementById('m9g-easter-egg-popup');
        var closeBtn = document.getElementById('m9g-easter-egg-close');
        if (whyBtn && popup) {
          whyBtn.addEventListener('click', function (ev) {
            ev.stopPropagation();
            var open = popup.classList.toggle('open');
            whyBtn.setAttribute('aria-expanded', open ? 'true' : 'false');
          });
          if (closeBtn) {
            closeBtn.addEventListener('click', function () {
              popup.classList.remove('open');
              whyBtn.setAttribute('aria-expanded', 'false');
            });
          }
        }

        var canvas = document.getElementById('m9g-particle-canvas');
        var prefersReducedMotion =
          window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (canvas && !prefersReducedMotion) {
          var ctx = canvas.getContext('2d');
          if (ctx) {
            var palette = [
              'rgba(66, 133, 244, ',
              'rgba(212, 175, 55, ',
              'rgba(30, 142, 62, ',
              'rgba(234, 67, 53, ',
            ];
            var w = window.innerWidth;
            var h = window.innerHeight;
            var count = w < 768 ? 26 : 52;
            var particles = [];
            var rafId = 0;

            function resize() {
              w = window.innerWidth;
              h = window.innerHeight;
              var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
              canvas.width = w * dpr;
              canvas.height = h * dpr;
              ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
            }

            function initParticles() {
              particles = [];
              for (var i = 0; i < count; i++) {
                particles.push({
                  x: Math.random() * w,
                  y: Math.random() * h,
                  vx: (Math.random() - 0.5) * 0.32,
                  vy: (Math.random() - 0.5) * 0.32,
                  r: Math.random() * 1.6 + 1,
                  alpha: Math.random() * 0.4 + 0.2,
                  color: palette[i % palette.length],
                });
              }
            }

            function step() {
              if (document.hidden) {
                rafId = 0;
                return;
              }
              ctx.clearRect(0, 0, w, h);
              for (var i = 0; i < particles.length; i++) {
                var p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                if (p.x < 0) p.x = w;
                if (p.x > w) p.x = 0;
                if (p.y < 0) p.y = h;
                if (p.y > h) p.y = 0;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                ctx.fillStyle = p.color + p.alpha + ')';
                ctx.fill();
              }
              rafId = requestAnimationFrame(step);
            }

            resize();
            initParticles();
            step();
            window.addEventListener('resize', resize, { passive: true });
            document.addEventListener('visibilitychange', function () {
              if (!document.hidden && !rafId) {
                rafId = requestAnimationFrame(step);
              }
            });
          }
        }
      })();
    </script>
