---
import { getCollection } from 'astro:content';
import ThemeHead from '../components/ThemeHead.astro';
import '../styles/tokens.css';
import {
  COMMON_I18N,
  DEFAULT_LOCALE,
  LOCALE_OPTIONS,
  PORTAL_I18N,
  SUPPORTED_LOCALES,
  type Locale,
} from '../i18n/ui';

const blogs = (await getCollection('blogs')).sort((a, b) => b.data.order - a.data.order);
const latestBlog = blogs[0];
if (!latestBlog) {
  throw new Error('Expected at least one blog entry in blogs collection');
}

const en = {
  ...COMMON_I18N[DEFAULT_LOCALE],
  ...PORTAL_I18N[DEFAULT_LOCALE],
};

const portalI18nMap = Object.fromEntries(
  SUPPORTED_LOCALES.map((locale: Locale) => [
    locale,
    {
      ...COMMON_I18N[locale],
      ...PORTAL_I18N[locale],
    },
  ]),
);

const demoVideos = [
  {
    id: 'PPZ4vgVZlyA',
    title: 'Gemini Robotics ER-2 vs. Gemini 4 Carbon: Multi-Robot Task Planner Benchmark (Isaac Sim 6.0 & ROS 2)',
    url: 'https://www.youtube.com/watch?v=PPZ4vgVZlyA',
    thumbnail: 'https://img.youtube.com/vi/PPZ4vgVZlyA/maxresdefault.jpg',
    descKey: 'vlaBenchDescHtml' as const,
  },
  {
    id: 'q-D9H9anNl8',
    title: 'EP 12. Multi Robot Collaboration | Gemini Robotics ER2 & NVIDIA IsaacSim & ROS2',
    url: 'https://www.youtube.com/watch?v=q-D9H9anNl8',
    thumbnail: 'https://img.youtube.com/vi/q-D9H9anNl8/hqdefault.jpg',
    descKey: 'ep12DescHtml' as const,
  },
  {
    id: 'stxaWN7Ct8Y',
    title: 'EP 11. FR3 Robots Cooperating with Gemini Robotics-ER2 & Isaac Sim | React Flow Digital Twin',
    url: 'https://www.youtube.com/watch?v=stxaWN7Ct8Y',
    thumbnail: 'https://img.youtube.com/vi/stxaWN7Ct8Y/maxresdefault.jpg',
    descKey: 'ep11DescHtml' as const,
  },
  {
    id: 'MzAGXiZmrdY',
    title: 'EP 10. Natural Language Multi-Robot Control | Isaac Sim, ROS 2 & Gemini Robotics-ER 2',
    url: 'https://www.youtube.com/watch?v=MzAGXiZmrdY',
    thumbnail: 'https://img.youtube.com/vi/MzAGXiZmrdY/maxresdefault.jpg',
    descKey: 'ep10DescHtml' as const,
  },
  {
    id: '5ydQRDwkg34',
    title: 'EP 7. Random Target Multi-Robots on NVIDIA IsaacSim w/ Antigravity, Gemini, ROS2',
    url: 'https://youtu.be/5ydQRDwkg34?si=z_TNSfY_MFlpukyS',
    thumbnail: 'https://img.youtube.com/vi/5ydQRDwkg34/maxresdefault.jpg',
    descKey: 'v3DescHtml' as const,
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://mincasurong.github.io/#website',
      url: 'https://mincasurong.github.io/',
      name: 'M9G | Minsu Chang, Ph.D. · Robotics, Multi-Robot TAMP & Agentic Systems',
      alternateName: ["We're M9G", 'mincasurong', 'Minsu Chang Portfolio', '장민수 포트폴리오'],
      inLanguage: ['en', 'ko', 'ja', 'es', 'zh'],
    },
    {
      '@type': 'Person',
      '@id': 'https://mincasurong.github.io/#person',
      name: 'Minsu Chang',
      alternateName: ['장민수', 'mincasurong', 'M9G'],
      jobTitle: 'Ph.D. Robotics Research Engineer & Agentic Systems Builder',
      url: 'https://mincasurong.github.io/',
      sameAs: [
        'https://www.linkedin.com/in/mincasurong/',
        'https://github.com/mincasurong',
      ],
      knowsAbout: [
        'Multi-Robot Task and Motion Planning (TAMP)',
        'Vision-Language-Action (VLA) Models',
        'NVIDIA Isaac Sim',
        'ROS 2 & MoveIt 2',
        'Nonlinear and Adaptive Control',
        'KFDA-Certified Rehabilitation Exoskeletons',
        'Agentic AI Systems',
      ],
      award: '1st Place, Google Gemini 3 Seoul Hackathon 2026 (GeminiSpace)',
    },
  ],
};
---

<!doctype html>
<html lang="en" class="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="jR2uBrMq04y0mxs-VvLnyGF-Y-FmIxoD1cpXaS_eYFo" />
    <meta name="naver-site-verification" content="8643cdcaff94efd9e270df35c3750ec6d9fdfd91" />
    <title>M9G | Minsu Chang, Ph.D. · Robotics, Multi-Robot TAMP &amp; Agentic Systems</title>
    <meta
      name="description"
      content="Research and systems engineering hub of Minsu Chang, Ph.D. (장민수 · M9G · mincasurong): multi-robot Task and Motion Planning (TAMP) in NVIDIA Isaac Sim 6.0 and ROS 2 ($0.01972, -76.6%, 610/610), browser 3D WebGL Fast-Sim (<25 ms IK, 720.0/h), 1st Place at Google Gemini 3 Seoul Hackathon 2026, 12 ROS/MoveIt/Jetson Nano tutorials, 21 peer-reviewed papers, and 14+ US/KR patents."
    />
    <meta
      name="keywords"
      content="Minsu Chang, 장민수, M9G, mincasurong, Robotics, Physical AI, TAMP, VLA, Vision-Language-Action, NVIDIA Isaac Sim, ROS 2, MoveIt 2, Jetson Nano, Gemini 3 Seoul Hackathon, GeminiSpace, Rehabilitation Exoskeleton, SUBAR, AI Therapist, Agentic AI"
    />
    <meta name="author" content="Minsu Chang, Ph.D." />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
    <link rel="canonical" href="https://mincasurong.github.io/" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mincasurong.github.io/" />
    <meta property="og:title" content="M9G | Minsu Chang, Ph.D. · Robotics, Multi-Robot TAMP &amp; Agentic Systems" />
    <meta
      property="og:description"
      content="Research and engineering hub of Minsu Chang, Ph.D. (M9G): 1st Place at Google Gemini 3 Seoul Hackathon 2026, Isaac Sim 6.0 &amp; ROS 2 multi-robot VLA benchmarks ($0.01972, -76.6%, 610/610), 3D WebGL Fast-Sim (<25 ms IK, 720.0/h), 21 papers, and 14+ US/KR patents."
    />
    <meta property="og:image" content="https://mincasurong.github.io/screenshots/vla-architecture-nanobanana.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="M9G | Minsu Chang, Ph.D. · Robotics, Multi-Robot TAMP &amp; Agentic Systems" />
    <meta
      name="twitter:description"
      content="Research and engineering hub of Minsu Chang, Ph.D. (M9G): 1st Place at Google Gemini 3 Seoul Hackathon 2026, Isaac Sim 6.0 &amp; ROS 2 multi-robot VLA benchmarks ($0.01972, -76.6%, 610/610), 3D WebGL Fast-Sim (<25 ms IK, 720.0/h), 21 papers, and 14+ US/KR patents."
    />
    <meta name="twitter:image" content="https://mincasurong.github.io/screenshots/vla-architecture-nanobanana.png" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <ThemeHead />
    <style>
      .portal-shell {
        min-height: 100vh;
        position: relative;
        overflow-x: hidden;
      }

      .particle-canvas {
        position: fixed;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 0;
        opacity: 0.55;
      }

      .portal-main {
        position: relative;
        z-index: 10;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 16px;
      }

      @media (min-width: 640px) {
        .portal-main {
          padding: 0 24px;
        }
      }

      @media (min-width: 1024px) {
        .portal-main {
          padding: 0 32px;
        }
      }

      .lang-switcher {
        position: relative;
        flex-shrink: 0;
      }

      .lang-menu {
        position: absolute;
        right: 0;
        top: calc(100% + 6px);
        width: 132px;
        background: var(--m9g-bg-modal);
        border: 1px solid var(--m9g-border);
        border-radius: 10px;
        box-shadow: var(--m9g-shadow-lg);
        z-index: 60;
        overflow: hidden;
        display: none;
      }

      .lang-menu.open {
        display: block;
      }

      .lang-option {
        width: 100%;
        text-align: left;
        padding: 8px 14px;
        font-size: 11.5px;
        font-family: inherit;
        background: transparent;
        border: none;
        color: var(--m9g-text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: background-color 0.15s ease, color 0.15s ease;
      }

      .lang-option:hover,
      .lang-option.active {
        background: var(--m9g-bg-accent-soft);
        color: var(--m9g-accent);
        font-weight: 700;
      }

      .hero-section {
        padding: 4rem 1.5rem 3.5rem;
        border-bottom: 1px solid var(--m9g-border);
      }

      .hero-inner {
        max-width: 1024px;
        margin: 0 auto;
      }

      .hero-title {
        font-family: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: clamp(2rem, 4.5vw, 3.6rem);
        font-weight: 800;
        letter-spacing: -0.025em;
        line-height: 1.12;
        color: var(--m9g-text);
        margin: 0 0 1rem;
      }

      .hero-subrow {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px 14px;
      }

      .hero-subtitle {
        font-size: clamp(1.08rem, 2.2vw, 1.45rem);
        color: var(--m9g-text-secondary);
        margin: 0;
        line-height: 1.5;
      }

      .hero-pills {
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .portal-section {
        padding: 3.5rem 0;
      }

      .portal-container-md {
        max-width: 1024px;
        margin: 0 auto;
      }

      .portal-container-lg {
        max-width: 1120px;
        margin: 0 auto;
      }

      .section-header-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--m9g-border);
      }

      .section-title-group {
        display: flex;
        align-items: center;
        gap: 10px;
      }

      .section-title-group svg {
        color: var(--m9g-accent);
        flex-shrink: 0;
      }

      .section-kicker-heading {
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--m9g-accent);
        margin: 0;
      }

      .section-lead {
        font-size: 1rem;
        color: var(--m9g-text-secondary);
        margin: 0 0 2rem;
        max-width: 48rem;
      }

      .profile-header {
        text-align: center;
        margin-bottom: 1.5rem;
      }

      .profile-heading {
        font-family: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: clamp(1.25rem, 2.6vw, 1.85rem);
        font-weight: 800;
        color: var(--m9g-text);
        margin: 0.75rem 0 0;
        line-height: 1.25;
      }

      .grid-2col {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
      }

      @media (min-width: 640px) {
        .grid-2col {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .photo-frame {
        aspect-ratio: 16 / 9;
        width: 100%;
        overflow: hidden;
        background: #000000;
      }

      .photo-frame picture,
      .photo-frame img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
      }

      .gblog-photo-card:hover .photo-frame img {
        transform: scale(1.04);
      }

      .photo-cap-kicker {
        font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--m9g-accent);
        margin-bottom: 2px;
      }

      .photo-cap-title {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--m9g-text);
      }

      .action-card-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
      }

      .news-card {
        padding: 1.5rem;
        border-radius: 24px;
        background: var(--m9g-bg-card);
        border: 1px solid var(--m9g-border);
        box-shadow: var(--m9g-shadow-md);
      }

      @media (min-width: 640px) {
        .news-card {
          padding: 2.25rem;
        }
      }

      .news-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 4px 12px;
        border-radius: 9999px;
        background: var(--m9g-bg-accent-soft);
        border: 1px solid var(--m9g-accent-border);
        color: var(--m9g-accent);
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        margin-bottom: 1rem;
      }

      .news-title {
        font-family: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: clamp(1.5rem, 3.4vw, 2.65rem);
        font-weight: 800;
        line-height: 1.18;
        color: var(--m9g-text);
        margin: 0 0 1.5rem;
      }

      .video-hero-link {
        display: block;
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        max-height: 360px;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid var(--m9g-border);
        background: #000000;
        margin-bottom: 1.5rem;
      }

      .video-hero-link img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
      }

      .video-hero-link:hover img {
        transform: scale(1.03);
      }

      .video-play-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.35);
        opacity: 0;
        transition: opacity 0.2s ease;
      }

      .video-hero-link:hover .video-play-overlay,
      .video-card:hover .video-play-overlay {
        opacity: 1;
      }

      .video-play-circle {
        width: 56px;
        height: 56px;
        border-radius: 9999px;
        background: var(--m9g-accent);
        color: var(--m9g-accent-contrast);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: var(--m9g-shadow-md);
      }

      .news-copy {
        font-size: 1rem;
        color: var(--m9g-text-secondary);
        line-height: 1.7;
        margin: 0 0 1rem;
      }

      .geminispace-cta-card {
        margin-top: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 18px 20px;
        border-radius: 18px;
        background: var(--m9g-accent);
        color: var(--m9g-accent-contrast);
        border: 1.5px solid var(--m9g-accent);
        box-shadow: var(--m9g-shadow-lg);
        text-decoration: none;
        transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
      }

      @media (min-width: 640px) {
        .geminispace-cta-card {
          flex-direction: row;
          align-items: center;
          justify-content: space-between;
        }
      }

      .geminispace-cta-card:hover {
        background: var(--m9g-accent-hover);
        border-color: var(--m9g-accent-hover);
        transform: translateY(-2px);
        box-shadow: var(--m9g-shadow-hover);
      }

      .geminispace-cta-main {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        min-width: 0;
      }

      .geminispace-cta-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        background: var(--m9g-accent-contrast);
        color: var(--m9g-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .geminispace-cta-title-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
      }

      .geminispace-cta-title {
        font-size: 1.05rem;
        font-weight: 800;
      }

      .geminispace-cta-pill {
        font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        padding: 2px 8px;
        border-radius: 9999px;
        border: 1px solid currentColor;
      }

      .geminispace-cta-sub {
        font-size: 0.85rem;
        margin: 0;
        opacity: 0.92;
      }

      .news-links-grid {
        margin-top: 1rem;
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
      }

      @media (min-width: 640px) {
        .news-links-grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }

      .news-ext-link {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-radius: 12px;
        border: 1px solid var(--m9g-border);
        background: var(--m9g-bg-card-solid);
        color: var(--m9g-text);
        font-size: 0.875rem;
        font-weight: 600;
        text-decoration: none;
        transition: border-color 0.18s ease, background-color 0.18s ease, color 0.18s ease;
      }

      .news-ext-link:hover {
        border-color: var(--m9g-accent);
        background: var(--m9g-bg-accent-soft);
        color: var(--m9g-accent);
      }

      .subsection-bar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 1.25rem;
        padding-left: 12px;
        border-left: 2px solid var(--m9g-accent);
      }

      .subsection-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 0.76rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.16em;
        color: var(--m9g-text);
      }

      .subsection-title svg {
        color: var(--m9g-accent);
        flex-shrink: 0;
      }

      .subsection-divider {
        margin-bottom: 3rem;
        padding-bottom: 2.25rem;
        border-bottom: 1px solid var(--m9g-border);
      }

      .videos-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 28px 32px;
      }

      @media (min-width: 640px) {
        .videos-grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }

      .video-card {
        display: block;
        text-decoration: none;
        color: inherit;
      }

      .video-thumb {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--m9g-border);
        background: #000000;
        margin-bottom: 12px;
      }

      .video-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.45s ease;
      }

      .video-card:hover .video-thumb img {
        transform: scale(1.04);
      }

      .video-card-title {
        font-family: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--m9g-text);
        margin: 0 0 6px;
        line-height: 1.35;
        transition: color 0.18s ease;
      }

      .video-card:hover .video-card-title {
        color: var(--m9g-accent);
      }

      .video-card-desc {
        font-size: 0.875rem;
        color: var(--m9g-text-secondary);
        margin: 0;
        line-height: 1.55;
      }

      .apps-list {
        display: flex;
        flex-direction: column;
        gap: 18px;
      }

      .app-card {
        padding: 16px 20px;
        border-radius: 18px;
        border: 1px solid var(--m9g-border);
        background: var(--m9g-bg-card);
        box-shadow: var(--m9g-shadow-sm);
        display: flex;
        flex-direction: column;
        gap: 16px;
        align-items: center;
        justify-content: space-between;
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
      }

      @media (min-width: 768px) {
        .app-card {
          flex-direction: row;
          gap: 20px;
        }
      }

      .app-card:hover {
        border-color: var(--m9g-accent);
        transform: translateY(-3px);
        box-shadow: var(--m9g-shadow-lg);
      }

      .app-thumb {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        border-radius: 12px;
        overflow: hidden;
        border: 1px solid var(--m9g-border);
        background: #000000;
        flex-shrink: 0;
        display: block;
      }

      @media (min-width: 768px) {
        .app-thumb {
          width: 240px;
        }
      }

      .app-thumb picture,
      .app-thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: top;
        display: block;
        transition: transform 0.4s ease;
      }

      .app-card:hover .app-thumb img {
        transform: scale(1.04);
      }

      .app-type-pill {
        position: absolute;
        top: 8px;
        left: 8px;
        padding: 2px 8px;
        border-radius: 6px;
        background: rgba(17, 17, 17, 0.85);
        color: #ffffff;
        font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
      }

      .app-body {
        flex: 1;
        width: 100%;
        min-width: 0;
      }

      .app-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 6px;
      }

      .app-domain {
        font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        font-size: 11px;
        color: var(--m9g-text-muted);
      }

      .app-badge {
        font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: var(--m9g-accent);
        background: var(--m9g-bg-accent-soft);
        border: 1px solid var(--m9g-accent-border);
        padding: 2px 8px;
        border-radius: 6px;
      }

      .app-title {
        font-family: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
        font-size: 1.15rem;
        font-weight: 800;
        margin: 0 0 6px;
        line-height: 1.3;
      }

      .app-title a {
        text-decoration: none;
        color: var(--m9g-text);
        transition: color 0.18s ease;
      }

      .app-card:hover .app-title a {
        color: var(--m9g-accent);
      }

      .app-desc {
        font-size: 0.875rem;
        color: var(--m9g-text-secondary);
        margin: 0;
      }

      .app-cta-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 12px 20px;
        border-radius: 12px;
        background: var(--m9g-accent);
        color: var(--m9g-accent-contrast);
        font-size: 0.78rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-decoration: none;
        white-space: nowrap;
        flex-shrink: 0;
        transition: background-color 0.18s ease, transform 0.18s ease;
      }

      @media (min-width: 768px) {
        .app-cta-btn {
          width: auto;
        }
      }

      .app-cta-btn:hover {
        background: var(--m9g-accent-hover);
        transform: translateY(-1px);
      }

      .free-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 9999px;
        background: var(--m9g-bg-accent-soft);
        border: 1px solid var(--m9g-accent-border);
        color: var(--m9g-accent);
        font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        font-weight: 700;
      }

      .intro-kicker-row {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        margin-bottom: 1.25rem;
        font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.18em;
        color: var(--m9g-accent);
      }

      .portal-footer {
        padding: 2.5rem 0;
        margin-top: 1.5rem;
        border-top: 1px solid var(--m9g-border);
        background: var(--m9g-bg-footer);
        position: relative;
        z-index: 10;
      }

      .footer-inner {
        max-width: 1120px;
        margin: 0 auto;
        padding: 0 24px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        position: relative;
      }

      @media (min-width: 768px) {
        .footer-inner {
          flex-direction: row;
        }
      }

      .footer-left {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
      }

      .footer-copy {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--m9g-text-muted);
        margin: 0;
      }

      .why-m9g-btn {
        font-size: 10.5px;
        color: var(--m9g-accent);
        background: transparent;
        border: 1px solid var(--m9g-accent-border);
        padding: 3px 9px;
        border-radius: 6px;
        cursor: pointer;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-weight: 700;
        transition: background-color 0.15s ease;
      }

      .why-m9g-btn:hover {
        background: var(--m9g-bg-accent-soft);
      }

      .easter-egg-popup {
        position: absolute;
        bottom: calc(100% + 14px);
        left: 24px;
        max-width: 360px;
        width: calc(100vw - 48px);
        background: var(--m9g-bg-modal);
        border: 1px solid var(--m9g-accent-border);
        border-radius: 12px;
        padding: 20px;
        box-shadow: var(--m9g-shadow-lg);
        z-index: 70;
        font-size: 12.5px;
        color: var(--m9g-text-secondary);
        display: none;
      }

      .easter-egg-popup.open {
        display: block;
      }

      .easter-egg-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 10px;
      }

      .easter-egg-title {
        color: var(--m9g-accent);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 11px;
      }

      .easter-egg-close {
        background: transparent;
        border: none;
        color: var(--m9g-text-muted);
        cursor: pointer;
        font-size: 14px;
        padding: 2px 6px;
      }

      .easter-egg-box {
        background: var(--m9g-bg-code);
        padding: 12px;
        border-radius: 8px;
        border: 1px solid var(--m9g-border);
        font-family: 'JetBrains Mono Variable', 'JetBrains Mono', monospace;
        text-align: center;
      }

      .easter-egg-and {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--m9g-text-muted);
        margin: 4px 0;
      }
    </style>
  </head>
