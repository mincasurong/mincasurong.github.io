    function toggleLangMenu(e) {
      e.stopPropagation();
      document.getElementById('lang-popup').classList.toggle('open');
    }
    document.addEventListener('click', function(e) {
      var wrap = document.getElementById('lang-dropdown-wrap');
      if (wrap && !wrap.contains(e.target)) document.getElementById('lang-popup').classList.remove('open');
    });
    function setLang(lang) {
      if (!TUT_I18N[lang]) lang = 'en';
      try { localStorage.setItem('m9g_portfolio_lang', lang); } catch (e) {}
      document.documentElement.lang = lang;
      var lbl = document.getElementById('current-lang-label');
      if (lbl) lbl.textContent = lang.toUpperCase();
      document.querySelectorAll('.lang-option').forEach(function(opt) {
        opt.classList.toggle('active', opt.getAttribute('data-lang') === lang);
      });
      var popup = document.getElementById('lang-popup');
      if (popup) popup.classList.remove('open');
      var dict = TUT_I18N[lang];
      document.querySelectorAll('[data-i18n]').forEach(function(el) {
        if (el.dataset.origHtml === undefined) {
          el.dataset.origHtml = el.innerHTML;
        }
        if (lang === 'en') {
          if (el.innerHTML !== el.dataset.origHtml) {
            el.innerHTML = el.dataset.origHtml;
          }
          return;
        }
        var key = el.getAttribute('data-i18n');
        if (dict[key]) el.textContent = dict[key];
      });
    }
    (function initLang() {
      var saved = 'en';
      try { saved = localStorage.getItem('m9g_portfolio_lang') || 'en'; } catch (e) {}
      setLang(saved);
    })();

    (function initCanvas() {
      var reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var canvas = document.getElementById('fluid-canvas');
      if (canvas && !reducedMotion) {
        var ctx = canvas.getContext('2d');
        var width = window.innerWidth, height = window.innerHeight;
        var count = width < 640 ? 24 : 48;
        var particles = [];
        function resize() {
          var dpr = Math.min(window.devicePixelRatio || 1, 1.5);
          width = window.innerWidth; height = window.innerHeight;
          canvas.width = width * dpr; canvas.height = height * dpr;
          ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
          particles = [];
          for (var i = 0; i < count; i++) {
            particles.push({
              x: Math.random() * width, y: Math.random() * height,
              vx: (Math.random() - 0.5) * 0.25, vy: (Math.random() - 0.5) * 0.25,
              r: Math.random() * 1.6 + 0.8
            });
          }
        }
        window.addEventListener('resize', resize);
        resize();
        function step() {
          if (document.hidden) {
            requestAnimationFrame(step);
            return;
          }
          ctx.clearRect(0, 0, width, height);
          var isDark = document.documentElement.classList.contains('dark');
          var strokeBase = isDark ? 'rgba(212, 175, 55, ' : 'rgba(26, 115, 232, ';
          for (var i = 0; i < particles.length; i++) {
            var p = particles[i];
            p.x += p.vx; p.y += p.vy;
            if (p.x < 0) p.x = width; if (p.x > width) p.x = 0;
            if (p.y < 0) p.y = height; if (p.y > height) p.y = 0;
            ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = strokeBase + '0.32)'; ctx.fill();
            for (var j = i + 1; j < particles.length; j++) {
              var q = particles[j];
              var dx = p.x - q.x, dy = p.y - q.y, dSq = dx * dx + dy * dy;
              if (dSq < 16000) {
                ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y);
                ctx.strokeStyle = strokeBase + ((1 - Math.sqrt(dSq) / 126) * 0.12) + ')';
                ctx.lineWidth = 0.7; ctx.stroke();
              }
            }
          }
          requestAnimationFrame(step);
        }
        requestAnimationFrame(step);
      }

      var ring = document.getElementById('cursor-ring');
      var dot = document.getElementById('cursor-dot');
      if (ring && dot && !reducedMotion && window.matchMedia('(pointer: fine)').matches) {
        var tx = -100, ty = -100, rx = -100, ry = -100, vx = 0, vy = 0;
        window.addEventListener('mousemove', function(e) {
          tx = e.clientX; ty = e.clientY;
          dot.style.transform = 'translate3d(' + (tx - 3.5) + 'px, ' + (ty - 3.5) + 'px, 0)';
          var t = e.target;
          var hover = !!(t && (t.tagName === 'A' || t.tagName === 'BUTTON' || (t.closest && (t.closest('a') || t.closest('button')))));
          ring.classList.toggle('hovering', hover);
          dot.classList.toggle('hovering', hover);
        }, { passive: true });
        (function springLoop() {
          if (!document.hidden) {
            vx = (vx + (tx - rx) * 0.18) * 0.72;
            vy = (vy + (ty - ry) * 0.18) * 0.72;
            rx += vx; ry += vy;
            var off = ring.classList.contains('hovering') ? 26 : 17;
            ring.style.transform = 'translate3d(' + (rx - off) + 'px, ' + (ry - off) + 'px, 0)';
          }
          requestAnimationFrame(springLoop);
        })();
      }
      var cards = document.querySelectorAll('.module-card, .spec-cell, .side-panel');
      cards.forEach(function(el, idx) {
        if (el.classList.contains('module-card')) {
          el.classList.add(idx % 2 === 0 ? 'reveal-left' : 'reveal-right');
        } else {
          el.classList.add('reveal-on-scroll');
        }
      });
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.05, rootMargin: '0px 0px -24px 0px' });
      cards.forEach(function(el) { io.observe(el); });
    })();
</script>
