---
import ThemeHead from '../../components/ThemeHead.astro';
---
<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ROS 2, MoveIt 2 &amp; Jetson Nano Edge AI Tutorials · M9G Engineering Hub</title>
  <link rel="canonical" href="https://mincasurong.github.io/tutorials/" />
  <meta name="robots" content="index, follow" />
  <meta name="description" content="Hands-on robotics and Edge AI tutorials by Minsu Chang, Ph.D. (M9G): native ROS 2 Foxy and MoveIt 2 on Windows 10, ROS 1 Melodic, MoveIt 1, and ROS Navigation Stack in WSL2 Ubuntu 18.04, plus an 8-module NVIDIA Jetson Nano CSI Camera Vision and TensorRT SSD Transfer Learning Bootcamp." />
  <meta property="og:title" content="ROS, MoveIt &amp; Jetson Nano Tutorials Hub · M9G" />
  <meta property="og:description" content="Step-by-step guides for robotic manipulation, mobile navigation, and NVIDIA Jetson Nano SSD-MobileNet TensorRT transfer learning." />
  <ThemeHead />
  <style is:global>
    :root {
      --bg: #ffffff;
      --surface: #f8f9fa;
      --surface-alt: #f1f3f4;
      --card-bg: rgba(255, 255, 255, 0.92);
      --border: #dadce0;
      --border-subtle: #e8eaed;
      --text: #202124;
      --text-body: #3c4043;
      --text-secondary: #5f6368;
      --text-muted: #70757a;
      --accent: #1a73e8;
      --accent-bg: #e8f0fe;
      --accent-border: rgba(26, 115, 232, 0.35);
      --gold: #1a73e8;
      --g-green: #1a73e8;
      --g-green-dark: #174ea6;
      --g-green-bg: #e8f0fe;
      --g-amber: #1a73e8;
      --g-amber-bg: #e8f0fe;
      --g-red: #1a73e8;
      --g-red-bg: #e8f0fe;
      --code-bg: #0f172a;
      --code-text: #e2e8f0;
      --font-sans: 'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-display: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-serif: 'Playfair Display', Georgia, serif;
      --font-mono: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
    }
    html.dark {
      --bg: #111111;
      --surface: #181818;
      --surface-alt: #222222;
      --card-bg: rgba(22, 22, 22, 0.9);
      --border: #2a2a2a;
      --border-subtle: #222222;
      --text: #fcfcfb;
      --text-body: #f1f5f9;
      --text-secondary: #cbd5e1;
      --text-muted: #94a3b8;
      --accent: #fbbf24;
      --accent-bg: rgba(251, 191, 36, 0.14);
      --accent-border: rgba(251, 191, 36, 0.4);
      --g-green-dark: #fbbf24;
      --g-green-bg: rgba(251, 191, 36, 0.14);
      --g-amber: #fbbf24;
      --g-amber-bg: rgba(251, 191, 36, 0.14);
      --code-bg: #09090b;
      --code-text: #f1f5f9;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0; width: 100%; max-width: 100%;
      overflow-x: clip;
      background: var(--bg); color: var(--text);
      font-family: var(--font-sans); font-size: 15.5px; line-height: 1.65;
      -webkit-font-smoothing: antialiased;
      scroll-behavior: smooth;
    }
    #fluid-canvas {
      position: fixed; inset: 0; width: 100%; height: 100%;
      pointer-events: none; z-index: 0; opacity: 0.65;
    }
    #progress-bar {
      position: fixed; top: 0; left: 0; height: 3px; width: 0%; z-index: 100;
      background: linear-gradient(90deg, #4285f4 0%, #ea4335 33%, #fbbc04 66%, #34a853 100%);
    }
    html.dark #progress-bar {
      background: linear-gradient(90deg, #d4af37 0%, #f59e0b 50%, #fef08a 100%);
    }
    a { color: inherit; text-decoration: none; }
    img, svg, video, iframe { max-width: 100%; height: auto; display: block; }


    .cursor-ring, .cursor-dot {
      position: fixed; top: 0; left: 0; pointer-events: none; z-index: 9999;
      border-radius: 50%; display: none; will-change: transform;
    }
    @media (pointer: fine) and (min-width: 1024px) {
      .cursor-ring {
        display: block; width: 34px; height: 34px;
        border: 1.5px solid rgba(26, 115, 232, 0.45);
        background: rgba(212, 175, 55, 0.04);
        transition: width 0.2s cubic-bezier(0.22, 1, 0.36, 1), height 0.2s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease, border-color 0.2s ease;
      }
      .cursor-ring.hovering {
        width: 52px; height: 52px;
        border-color: rgba(212, 175, 55, 0.75);
        background: rgba(26, 115, 232, 0.08);
      }
      .cursor-dot {
        display: block; width: 7px; height: 7px;
        background: var(--accent);
        transition: opacity 0.15s ease, transform 0.15s ease;
      }
      .cursor-dot.hovering { opacity: 0; }
    }
    .reveal-on-scroll, .reveal-left, .reveal-right {
      opacity: 0;
      transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal-on-scroll { transform: translateY(26px); }
    .reveal-left { transform: translateX(-34px) translateY(14px); }
    .reveal-right { transform: translateX(34px) translateY(14px); }
    .reveal-on-scroll.is-visible, .reveal-left.is-visible, .reveal-right.is-visible {
      opacity: 1; transform: translate3d(0, 0, 0);
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal-on-scroll, .reveal-left, .reveal-right { opacity: 1; transform: none; transition: none; }
    }
    .module-card:hover, .spec-cell:hover, .side-panel:hover {
      transform: translateY(-4px) translateX(3px);
      border-color: var(--accent);
      box-shadow: 0 14px 32px rgba(26, 115, 232, 0.1);
    }

    .hero-pill-btn {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 4px 10px; border-radius: 9999px;
      font-size: 12px; font-weight: 600; line-height: 1.2;
      transition: all 0.15s ease; text-decoration: none;
    }
    .hero-pill-btn:hover { transform: translateY(-1px); }
    .hero-pill-github {
      background: rgba(255, 255, 255, 0.07); color: #e8eaed !important;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .hero-pill-github:hover {
      background: rgba(255, 255, 255, 0.16); color: #ffffff !important;
      border-color: rgba(255, 255, 255, 0.4);
    }
    .hero-pill-linkedin {
      background: rgba(26, 115, 232, 0.18); color: #8ab4f8 !important;
      border: 1px solid rgba(138, 180, 248, 0.38);
    }
    .hero-pill-linkedin:hover {
      background: #1a73e8; color: #ffffff !important; border-color: #1a73e8;
    }
    html.light .hero-pill-github {
      background: #f1f3f4 !important; color: #202124 !important; border-color: #dadce0 !important;
    }
    html.light .hero-pill-linkedin {
      background: #e8f0fe !important; color: #1a73e8 !important; border-color: rgba(26, 115, 232, 0.32) !important;
    }
    .topbar {
      position: sticky; top: 0; z-index: 50;
      background: var(--card-bg); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }
    .topbar-inner {
      max-width: 1080px; margin: 0 auto; padding: 4px 14px; min-height: 42px;
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
    }
    .brand {
      font-family: var(--font-display); font-size: 16px; font-weight: 800; color: var(--text);
      display: flex; align-items: center; gap: 8px; flex-shrink: 0;
    }
    .g-m { color: #4285f4; } .g-9 { color: #ea4335; } .g-g { color: #34a853; }
    .brand-sep { color: var(--border); font-weight: 400; }
    .brand-sec { font-size: 13px; font-weight: 600; color: var(--accent); }
    .topnav {
      display: flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600;
      color: var(--text-secondary); overflow-x: auto; scrollbar-width: none; white-space: nowrap; min-width: 0;
    }
    .topnav::-webkit-scrollbar { display: none; }
    .topnav a { padding: 4px 7px; line-height: 1.1; border-radius: 6px; }
    .topnav a:hover { color: var(--accent); }
    .topnav a.active-nav { color: var(--accent); font-weight: 700; }
    .topnav a.back-link {
      color: #ffffff; background: #1a73e8; font-weight: 600; padding: 5px 12px; border-radius: 999px; font-size: 12.5px;
    }
    .topbar-btn, .ctrl-btn {
      height: 28px; padding: 0 9px; border-radius: 999px; border: 1px solid var(--border);
      background: var(--surface); color: var(--text); font-family: var(--font-mono);
      font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;
    }
    .topbar-btn:hover, .ctrl-btn:hover { border-color: var(--accent); color: var(--accent); }
    .lang-dropdown-wrap { position: relative; }
    .lang-popup {
      position: absolute; top: calc(100% + 6px); right: 0; min-width: 132px;
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.2); padding: 4px; display: none; z-index: 300;
    }
    .lang-popup.open { display: block; }
    .lang-option {
      width: 100%; text-align: left; background: transparent; border: 0; border-radius: 6px;
      padding: 6px 10px; font-size: 12px; font-weight: 600; color: var(--text-secondary);
      display: flex; align-items: center; justify-content: space-between; cursor: pointer;
    }
    .lang-option:hover { background: var(--surface-alt); color: var(--text); }
    .lang-option.active { background: var(--accent-bg); color: var(--accent); font-weight: 700; }

    .layout {
      position: relative; z-index: 1;
      max-width: 1200px; margin: 0 auto; padding: 32px 16px 80px;
      display: grid; grid-template-columns: minmax(0, 840px) 290px;
      justify-content: space-between; gap: 36px; align-items: start;
    }
    @media (max-width: 980px) {
      .layout { grid-template-columns: minmax(0, 1fr); }
      .sidebar { position: static !important; }
    }
    @media (max-width: 640px) {
      .brand-sec, .brand-sep { display: none; }
      .spec-strip { grid-template-columns: repeat(2, minmax(0, 1fr)) !important; }
    }

    .post-meta-top {
      font-size: 12px; font-weight: 600; color: var(--text-secondary); margin-bottom: 10px;
      display: flex; flex-wrap: wrap; gap: 8px; align-items: center;
    }
    .tag {
      background: var(--accent-bg); color: var(--accent); border: 1px solid var(--accent-border);
      padding: 2px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.04em;
    }
    h1 {
      font-family: var(--font-display); font-size: clamp(1.65rem, 3.8vw, 2.45rem); font-weight: 800;
      line-height: 1.2; letter-spacing: -0.02em; color: var(--text); margin: 0 0 14px 0;
    }
    .lede { font-size: 1.02rem; color: var(--text-secondary); margin: 0 0 22px 0; line-height: 1.65; }
    .spec-strip {
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 24px;
    }
    .spec-cell {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 12px 14px;
    }
    .spec-label { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-muted); margin-bottom: 4px; }
    .spec-val { font-family: var(--font-display); font-size: 1.2rem; font-weight: 800; color: var(--accent); }
    .spec-val.green { color: var(--g-green-dark); }
    .spec-note { font-size: 11.5px; color: var(--text-secondary); margin-top: 2px; line-height: 1.35; }

    .track-tabs {
      display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 28px;
      padding: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    }
    .track-tab {
      border: 1px solid transparent; background: transparent; color: var(--text-secondary);
      font-family: var(--font-sans); font-size: 12.5px; font-weight: 700;
      padding: 8px 14px; border-radius: 8px; cursor: pointer; transition: all 0.15s ease;
    }
    .track-tab:hover { color: var(--text); background: var(--surface-alt); }
    .track-tab.active {
      background: var(--accent); color: #ffffff;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    }
    html.dark .track-tab.active { color: #111111; }

    .tutorial-section { margin-bottom: 44px; scroll-margin-top: 72px; }
    .section-banner {
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px;
      border-bottom: 2px solid var(--border); padding-bottom: 10px; margin-bottom: 20px;
    }
    .section-banner h2 {
      font-family: var(--font-display); font-size: 1.42rem; font-weight: 800; color: var(--text); margin: 0;
    }
    .module-card {
      background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px;
      padding: 20px 22px; margin-bottom: 22px; scroll-margin-top: 76px;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .module-card:hover { border-color: var(--accent-border); }
    .module-header {
      display: flex; align-items: flex-start; justify-content: space-between; flex-wrap: wrap; gap: 10px;
      margin-bottom: 12px;
    }
    .module-badge {
      font-family: var(--font-mono); font-size: 11px; font-weight: 700; text-transform: uppercase;
      padding: 3px 9px; border-radius: 6px; background: var(--accent-bg); color: var(--accent);
      border: 1px solid var(--accent-border);
    }
    .module-title {
      font-family: var(--font-display); font-size: 1.18rem; font-weight: 800; color: var(--text);
      margin: 6px 0 8px 0; line-height: 1.3;
    }
    p, li { color: var(--text-body); }
    p { margin: 0 0 12px 0; }
    ul, ol { margin: 0 0 16px 0; padding-left: 20px; }
    li { margin-bottom: 8px; }
    li strong { color: var(--text); }
    code {
      font-family: var(--font-mono); font-size: 0.84em; background: var(--surface-alt);
      border: 1px solid var(--border); color: var(--accent); padding: 1px 6px; border-radius: 4px;
      overflow-wrap: anywhere;
    }

    .cmd-block {
      background: var(--code-bg); color: var(--code-text);
      border: 1px solid #334155; border-radius: 10px; margin: 12px 0 16px; overflow: hidden;
    }
    .cmd-top {
      background: rgba(255, 255, 255, 0.06); padding: 6px 12px;
      display: flex; align-items: center; justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      font-family: var(--font-mono); font-size: 11px; color: #94a3b8;
    }
    .copy-btn {
      background: rgba(255, 255, 255, 0.1); border: 1px solid rgba(255, 255, 255, 0.2);
      color: #f8fafc; font-family: var(--font-mono); font-size: 10.5px; font-weight: 600;
      padding: 2px 8px; border-radius: 5px; cursor: pointer; transition: all 0.15s;
    }
    .copy-btn:hover { background: var(--accent); color: #fff; border-color: var(--accent); }
    html.dark .copy-btn:hover { color: #111; }
    .cmd-block pre {
      margin: 0; padding: 12px 14px; overflow-x: auto;
      font-family: var(--font-mono); font-size: 12.5px; line-height: 1.6; color: var(--code-text);
    }

    .video-grid {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; margin: 14px 0;
    }
    .video-box {
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 10px;
    }
    .video-box .v-label {
      font-size: 12px; font-weight: 700; color: var(--text); margin-bottom: 8px;
      display: flex; justify-content: space-between; align-items: center; gap: 6px;
    }
    .video-box .v-label a { color: var(--accent); font-family: var(--font-mono); font-size: 11px; text-decoration: underline; }
    .video-aspect {
      position: relative; width: 100%; aspect-ratio: 16 / 9; background: #000;
      border-radius: 8px; overflow: hidden; border: 1px solid var(--border);
    }
    .video-aspect iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

    .resource-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    .res-pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600;
      background: var(--surface); border: 1px solid var(--border); color: var(--text);
      transition: all 0.15s ease;
    }
    .res-pill:hover { border-color: var(--accent); color: var(--accent); background: var(--accent-bg); transform: translateY(-1px); }

    .tip-box {
      background: var(--g-amber-bg); border: 1px solid rgba(227, 116, 0, 0.35);
      border-left: 4px solid var(--g-amber); border-radius: 8px; padding: 12px 14px; margin: 12px 0;
      font-size: 13.5px; color: var(--text-body);
    }

    .sidebar { position: sticky; top: 70px; display: flex; flex-direction: column; gap: 16px; }
    .side-panel { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 16px; }
    .side-heading {
      font-size: 11.5px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
      color: var(--accent); margin: 0 0 10px 0; padding-bottom: 6px; border-bottom: 1px solid var(--border);
    }
    .side-links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 5px; font-size: 12.5px; }
    .side-links li { margin: 0; }
    .side-links a { color: var(--text-secondary); display: block; padding: 4px 6px; border-radius: 6px; font-weight: 500; }
    .side-links a:hover { color: var(--accent); background: var(--accent-bg); }
    .kv-list { list-style: none; margin: 0; padding: 0; font-family: var(--font-mono); font-size: 11.5px; display: flex; flex-direction: column; gap: 6px; }
    .kv-list li { margin: 0; display: flex; justify-content: space-between; gap: 8px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 5px; }
    .kv-list li:last-child { border-bottom: 0; padding-bottom: 0; }
    .kv-list span:first-child { color: var(--text-muted); }
    .kv-list span:last-child { color: var(--text); font-weight: 600; text-align: right; }

    footer {
      position: relative; z-index: 1;
      background: var(--surface); border-top: 1px solid var(--border);
      padding: 28px 16px; text-align: center; font-size: 12.5px; color: var(--text-secondary);
    }
    footer a { color: var(--accent); font-weight: 600; }
    footer a:hover { text-decoration: underline; }
  
    .m9g-gotop-bar {
      display: flex;
      justify-content: center;
      padding: 18px 16px 8px;
      position: relative;
      z-index: 10;
    }
    .m9g-gotop-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 20px;
      border-radius: 9999px;
      background: #e8f0fe;
      color: #1a73e8;
      border: 1px solid rgba(26, 115, 232, 0.34);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 0.03em;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
      box-shadow: 0 2px 10px rgba(26, 115, 232, 0.12);
    }
    .m9g-gotop-btn:hover {
      background: #1a73e8;
      color: #ffffff;
      border-color: #1a73e8;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(26, 115, 232, 0.24);
    }
    html.dark .m9g-gotop-btn,
    html:not(.light) .m9g-gotop-btn {
      background: rgba(212, 175, 55, 0.14);
      color: #fbbf24;
      border-color: rgba(212, 175, 55, 0.38);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    }
    html.dark .m9g-gotop-btn:hover,
    html:not(.light) .m9g-gotop-btn:hover {
      background: #fbbf24;
      color: #111111;
      border-color: #fbbf24;
    }
  </style>
</head>
<body>
  <canvas id="fluid-canvas"></canvas>
  <div id="cursor-ring" class="cursor-ring"></div>
  <div id="cursor-dot" class="cursor-dot"></div>
  <div id="progress-bar"></div>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <span><span class="g-m">M</span><span class="g-9">9</span><span class="g-g">G</span></span>
        <span class="brand-sep">|</span>
        <span class="brand-sec" data-i18n="headerBrand">Robotics &amp; Edge AI Tutorials</span>
      </a>
      <div style="display:flex; align-items:center; gap:6px; min-width:0; flex:1; justify-content:flex-end;">
        <nav class="topnav" style="gap:6px;">
          <a href="/vcard/" class="hero-pill-btn hero-pill-github"><span>CV</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
          <a href="/archive/" class="hero-pill-btn hero-pill-github"><span data-i18n="navArchive">Archive</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
          <a href="/blog/" class="hero-pill-btn hero-pill-github"><span data-i18n="navBlog">Blog</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
          <a href="/tutorials/" class="hero-pill-btn hero-pill-linkedin"><span data-i18n="navTutorials">Tutorials</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
          <a href="/" class="hero-pill-btn hero-pill-linkedin"><span data-i18n="navPortfolio">Main Portal</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
        </nav>
        <button class="topbar-btn" id="theme-btn" data-theme-toggle="icon-only" onclick="window.__m9gToggleTheme()" title="Toggle Light / Dark Theme">☀</button>
        <div class="lang-dropdown-wrap" id="lang-dropdown-wrap">
