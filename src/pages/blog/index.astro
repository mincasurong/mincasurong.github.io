---
import { getCollection } from 'astro:content';
import ThemeHead from '../../components/ThemeHead.astro';

const posts = (await getCollection('blogs')).sort((a, b) => b.data.order - a.data.order);

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'M9G Technical Research & Engineering Blog',
  url: 'https://mincasurong.github.io/blog/',
  description:
    'Technical research and engineering reports by Minsu (Max) Chang, Ph.D. (M9G): browser-native 3D WebGL TAMP at tamp.mincasurong.com (<25 ms IK, 720.0/h), UIUC Lazy-DaSH hypergraph planning, Self-Driving Labs (SDLs), Project STAMP deterministic safety gating (610/610 fault interception), 3-arm VLA benchmarks in Isaac Sim 6.0 and ROS 2 ($0.01972, -76.6%), and agentic coding tools.',
  author: {
    '@type': 'Person',
    name: 'Minsu (Max) Chang',
    honorificSuffix: 'Ph.D.',
    url: 'https://mincasurong.github.io/',
  },
  blogPost: posts.map((p) => ({
    '@type': 'TechArticle',
    headline: p.data.title,
    identifier: p.data.reportId,
    datePublished: p.data.publishedIso,
    dateModified: p.data.updatedIso,
    url: p.data.canonicalUrl,
  })),
};
---
<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>M9G | Technical Research Blog</title>
  <link rel="canonical" href="https://mincasurong.github.io/blog/" />
  <meta name="robots" content="index, follow" />
  <meta name="author" content="Minsu (Max) Chang, Ph.D." />
  <meta name="description" content="Technical research and engineering reports by Minsu (Max) Chang, Ph.D. (M9G): browser-native 3D WebGL TAMP at tamp.mincasurong.com (&lt;25 ms IK, 720.0/h), UIUC Lazy-DaSH hypergraph planning, Self-Driving Labs (SDLs), Project STAMP deterministic safety gating (610/610 fault interception), 3-arm VLA benchmarks in Isaac Sim 6.0 &amp; ROS 2 ($0.01972, -76.6%), and agentic coding tools." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://mincasurong.github.io/blog/" />
  <meta property="og:title" content="M9G | Technical Research Blog" />
  <meta property="og:description" content="Engineering reports and benchmarks on browser-native 3D WebGL TAMP (tamp.mincasurong.com, &lt;25 ms IK, 720.0/h), UIUC Lazy-DaSH hypergraphs, Self-Driving Labs, Project STAMP safety gating (610/610), multi-arm VLA planning in Isaac Sim 6.0 ($0.01972, -76.6%), and coding agent tools." />
  <meta property="og:image" content="https://mincasurong.github.io/screenshots/blog6-fastsim-thumb-nanobanana.png" />
  <meta name="twitter:card" content="summary_large_image" />
  <ThemeHead />
  <script type="application/ld+json" set:html={JSON.stringify(blogJsonLd)} />
  <style is:global>
    :root {
      --bg: #111111;
      --surface: rgba(20, 20, 20, 0.9);
      --surface-hover: #181818;
      --border: #1f2937;
      --text: #FCFCFB;
      --text-sub: #f1f5f9;
      --gold: #fbbf24;
      --gold-dim: rgba(251, 191, 36, 0.14);
      --gold-border: rgba(251, 191, 36, 0.35);
      --emerald: #fbbf24;
      --emerald-dim: rgba(251, 191, 36, 0.14);
      --emerald-border: rgba(251, 191, 36, 0.38);
      --font-sans: 'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-serif: Georgia, serif;
      --font-display: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
    }
    html.light {
      --bg: #ffffff;
      --surface: rgba(248, 249, 250, 0.94);
      --surface-hover: #f1f3f4;
      --border: #dadce0;
      --text: #202124;
      --text-sub: #3c4043;
      --gold: #1a73e8;
      --gold-dim: #e8f0fe;
      --gold-border: rgba(26, 115, 232, 0.28);
      --emerald: #1a73e8;
      --emerald-dim: #e8f0fe;
      --emerald-border: rgba(26, 115, 232, 0.32);
    }
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      width: 100%; max-width: 100%; overflow-x: clip;
      background: var(--bg); color: var(--text);
      font-family: var(--font-sans); font-size: 15px; line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      transition: background-color 0.25s ease, color 0.25s ease;
    }
    a { color: inherit; text-decoration: none; }
    img { max-width: 100%; height: auto; display: block; }
    button { font: inherit; background: none; border: none; color: inherit; cursor: pointer; }

    #progress-bar {
      position: fixed; top: 0; left: 0; height: 2px; width: 0%; z-index: 100;
      background: #ffffff;
    }
    html.light #progress-bar {
      height: 3px;
      background: linear-gradient(90deg, #4285f4 0%, #ea4335 33%, #fbbc04 66%, #34a853 100%);
    }
    #fluid-canvas {
      position: fixed; inset: 0; width: 100vw; height: 100vh;
      pointer-events: none; z-index: 0; opacity: 0.78;
    }
    html.light #fluid-canvas { opacity: 0.55; }
    .cursor-ring {
      position: fixed; top: 0; left: 0; width: 32px; height: 32px;
      border-radius: 9999px; border: 1.5px solid rgba(212, 175, 55, 0.55);
      pointer-events: none; z-index: 9999; transform: translate3d(-100px, -100px, 0);
    }
    .cursor-dot {
      position: fixed; top: 0; left: 0; width: 6px; height: 6px;
      border-radius: 9999px; background: var(--gold);
      pointer-events: none; z-index: 9999; transform: translate3d(-100px, -100px, 0);
    }
    @media (max-width: 768px), (pointer: coarse) {
      .cursor-ring, .cursor-dot { display: none !important; }
    }

    .topbar {
      position: sticky; top: 0; z-index: 50;
      background: rgba(17, 17, 17, 0.92); backdrop-filter: blur(8px);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    html.light .topbar {
      background: rgba(255, 255, 255, 0.96);
      border-bottom: 1px solid #dadce0;
    }
    .topbar-inner {
      max-width: 1080px; margin: 0 auto; padding: 4px 14px; min-height: 42px;
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
    }
    .brand {
      font-family: var(--font-display); font-size: 16px; font-weight: 800; color: var(--text);
      display: flex; align-items: center; gap: 8px; flex-shrink: 0;
    }
    .g-m { color: #4285f4; } .g-9 { color: #ea4335; } .g-g { color: #34a853; }
    .brand-sep { color: #475569; font-weight: 400; }
    html.light .brand-sep { color: #dadce0; }
    .brand-sec { font-size: 13px; font-weight: 600; color: #fbbf24; }
    html.light .brand-sec { color: #1a73e8; }
    @media (max-width: 600px) { .brand-sec, .brand-sep { display: none; } }

    .topnav {
      display: flex; align-items: center; gap: 6px;
      overflow-x: auto; scrollbar-width: none; white-space: nowrap; min-width: 0;
    }
    .topnav::-webkit-scrollbar { display: none; }
    .hero-pill-btn {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 4px 10px; border-radius: 9999px;
      font-size: 12px; font-weight: 600; line-height: 1.2;
      transition: all 0.15s ease;
    }
    .hero-pill-btn:hover { transform: translateY(-1px); }
    .hero-pill-github {
      background: rgba(255, 255, 255, 0.07); color: #e8eaed;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .hero-pill-github:hover {
      background: rgba(255, 255, 255, 0.16); color: #ffffff;
      border-color: rgba(255, 255, 255, 0.4);
    }
    .hero-pill-linkedin {
      background: rgba(251, 191, 36, 0.16); color: #fbbf24;
      border: 1px solid rgba(251, 191, 36, 0.42);
    }
    .hero-pill-linkedin:hover {
      background: #fbbf24; color: #111111; border-color: #fbbf24;
    }
    html.light .hero-pill-github {
      background: #f1f3f4; color: #202124; border-color: #dadce0;
    }
    html.light .hero-pill-github:hover {
      background: #e8f0fe; color: #174ea6; border-color: #1a73e8;
    }
    html.light .hero-pill-linkedin {
      background: #e8f0fe; color: #1a73e8; border-color: rgba(26, 115, 232, 0.32);
    }
    html.light .hero-pill-linkedin:hover {
      background: #1a73e8; color: #ffffff;
    }

    .topbar-btn {
      height: 28px; padding: 0 9px; border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(255, 255, 255, 0.06); color: #e2e8f0;
      font-family: var(--font-mono); font-size: 11px; font-weight: 700;
      display: inline-flex; align-items: center; gap: 4px; flex-shrink: 0;
    }
    html.light .topbar-btn {
      background: #f8f9fa; border-color: #dadce0; color: #202124;
    }
    .lang-dropdown-wrap { position: relative; }
    .lang-popup {
      position: absolute; top: calc(100% + 6px); right: 0; width: 128px;
      background: rgba(28, 28, 28, 0.96); backdrop-filter: blur(12px);
      border: 1px solid var(--border); border-radius: 8px;
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45); overflow: hidden; display: none; z-index: 300;
    }
    html.light .lang-popup { background: #f8f9fa; box-shadow: 0 10px 28px rgba(0, 0, 0, 0.12); }
    .lang-popup.open { display: block; }
    .lang-option {
      width: 100%; text-align: left; padding: 8px 14px; font-size: 11px;
      letter-spacing: 0.05em; color: var(--text-sub);
      display: flex; align-items: center; justify-content: space-between;
    }
    .lang-option:hover { background: rgba(255, 255, 255, 0.06); color: var(--gold); }
    html.light .lang-option:hover { background: #e8f0fe; color: #1a73e8; }
    .lang-option.active { color: var(--gold); font-weight: 700; background: rgba(20, 20, 20, 0.9); }
    html.light .lang-option.active { background: #e8f0fe; color: #1a73e8; }

    .main-wrap {
      max-width: 1120px; margin: 0 auto; padding: 56px 16px 84px;
      position: relative; z-index: 1;
    }

    .sec-head {
      display: flex; align-items: center; gap: 14px;
      margin-bottom: 16px; padding-bottom: 20px; border-bottom: 1px solid var(--border);
    }
    .sec-head svg { color: var(--gold); width: 22px; height: 22px; flex-shrink: 0; }
    .sec-eyebrow {
      font-size: 13px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.2em; color: var(--gold);
    }
    .sec-sub {
      font-size: 15.5px; color: var(--text-sub); margin-bottom: 28px; max-width: 760px;
    }

    .sub-bar {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
      gap: 12px; margin-bottom: 24px; border-left: 2px solid var(--gold); padding-left: 12px;
    }
    .sub-bar-left {
      display: flex; align-items: center; gap: 8px;
      font-size: 12px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.18em; color: var(--text);
    }
    .sub-bar-left svg { color: var(--gold); width: 16px; height: 16px; }
    .filter-pills { display: flex; flex-wrap: wrap; gap: 8px; }
    .filter-pill {
      padding: 5px 13px; border-radius: 999px; font-family: var(--font-mono);
      font-size: 11.5px; font-weight: 600;
      background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border); color: var(--text-sub);
      transition: all 0.18s ease;
    }
    html.light .filter-pill { background: #f1f3f4; }
    .filter-pill:hover { border-color: var(--gold); color: var(--text); }
    .filter-pill.active {
      background: var(--emerald-dim); border-color: var(--emerald-border); color: var(--emerald);
    }

    .showcase-list {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
    }
    @media (min-width: 720px) {
      .showcase-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      .showcase-card.featured-hero-card {
        grid-column: 1 / -1;
        display: grid;
        grid-template-columns: 1.38fr 1fr;
        align-items: stretch;
      }
    }
    .showcase-card {
      padding: 14px; border-radius: 18px;
      border: 1px solid var(--border); background: var(--surface);
      backdrop-filter: blur(12px);
      display: flex; flex-direction: column; gap: 14px;
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), border-color 0.2s ease, background-color 0.2s ease, box-shadow 0.28s ease;
      box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
      position: relative;
    }
    html.light .showcase-card { box-shadow: 0 8px 28px rgba(60, 64, 67, 0.08); }
    .showcase-card:hover {
      transform: translateY(-5px) scale(1.01);
      border-color: var(--gold); background: var(--surface-hover);
    }
    .showcase-card.hidden { display: none !important; }

    .card-thumb {
      position: relative; width: 100%; aspect-ratio: 16 / 9;
      border-radius: 12px; overflow: hidden; border: 1px solid var(--border);
      background: #ffffff; flex-shrink: 0; display: block;
    }
    .card-thumb picture {
      display: block; width: 100%; height: 100%;
    }
    .card-thumb img {
      width: 100%; height: 100%; object-fit: cover; object-position: center;
      transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .showcase-card:hover .card-thumb img { transform: scale(1.045); }
    .card-type-badge {
      position: absolute; top: 10px; left: 10px;
      padding: 4px 10px; border-radius: 6px;
      background: rgba(17, 17, 17, 0.88); border: 1px solid rgba(255, 255, 255, 0.18);
      font-family: var(--font-mono); font-size: 10.5px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.06em; color: #fbbf24;
      backdrop-filter: blur(6px);
    }
    html.light .card-type-badge {
      background: rgba(26, 115, 232, 0.92); color: #ffffff;
    }
    .card-duration-badge {
      position: absolute; bottom: 10px; right: 10px;
      padding: 3px 8px; border-radius: 5px;
      background: rgba(17, 17, 17, 0.88); color: #ffffff;
      font-family: var(--font-mono); font-size: 10.5px; font-weight: 700;
      display: inline-flex; align-items: center; gap: 5px;
      border: 1px solid rgba(255, 255, 255, 0.16);
    }
    .card-duration-dot {
      width: 6px; height: 6px; border-radius: 999px; background: #ef4444;
      display: inline-block;
    }

    .card-body {
      flex: 1; min-width: 0; display: flex; flex-direction: column;
      justify-content: space-between; padding: 2px 6px 4px;
    }
    .card-meta {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px;
    }
    .card-badge {
      font-family: var(--font-mono); font-size: 11px; font-weight: 700; text-transform: uppercase;
      letter-spacing: 0.04em; color: var(--gold);
      padding: 3px 9px; border-radius: 6px;
      background: var(--gold-dim); border: 1px solid var(--gold-border);
    }
    .card-title-row {
      display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
    }
    .card-title {
      font-family: var(--font-display); font-size: 1.16rem; font-weight: 800;
      color: var(--text); margin-bottom: 6px; line-height: 1.3;
      letter-spacing: -0.015em;
      transition: color 0.2s ease;
    }
    .showcase-card.featured-hero-card .card-title {
      font-size: clamp(1.25rem, 2.2vw, 1.52rem);
    }
    .showcase-card:hover .card-title { color: var(--gold); }
    .card-desc {
      font-size: 13px; color: var(--text-sub); line-height: 1.45;
      display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
    }
    .showcase-card.featured-hero-card .card-desc {
      -webkit-line-clamp: 2;
      font-size: 13.8px;
    }

    .card-icon-btn {
      display: inline-flex; align-items: center; justify-content: center;
      width: 34px; height: 34px; border-radius: 999px; flex-shrink: 0;
      background: var(--gold-dim); color: var(--gold);
      border: 1px solid var(--gold-border);
      transition: all 0.2s ease;
    }
    .showcase-card:hover .card-icon-btn {
      background: var(--gold); color: #ffffff; transform: translate(2px, -2px);
    }
    html:not(.light) .showcase-card:hover .card-icon-btn {
      color: #111111;
    }

    footer {
      padding: 44px 24px; border-top: 1px solid var(--border);
      background: var(--bg); position: relative; z-index: 1;
    }
    .footer-inner {
      max-width: 1120px; margin: 0 auto;
      display: flex; flex-direction: column; align-items: center; justify-content: space-between; gap: 16px;
    }
    @media (min-width: 768px) { .footer-inner { flex-direction: row; } }
    .footer-copy {
      font-size: 10.5px; color: var(--text-sub); text-transform: uppercase; letter-spacing: 0.06em;
    }

    .m9g-gotop-bar {
      display: flex;
      justify-content: center;
      padding: 18px 16px 8px;
      position: relative;
      z-index: 10;
    }
    .m9g-gotop-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 20px;
      border-radius: 9999px;
      background: #e8f0fe;
      color: #1a73e8;
      border: 1px solid rgba(26, 115, 232, 0.34);
      font-family: var(--font-display);
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 0.03em;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
      box-shadow: 0 2px 10px rgba(26, 115, 232, 0.12);
    }
    .m9g-gotop-btn:hover {
      background: #1a73e8;
      color: #ffffff;
      border-color: #1a73e8;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(26, 115, 232, 0.24);
    }
    html.dark .m9g-gotop-btn,
    html:not(.light) .m9g-gotop-btn {
      background: rgba(212, 175, 55, 0.14);
      color: #fbbf24;
      border-color: rgba(212, 175, 55, 0.38);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    }
    html.dark .m9g-gotop-btn:hover,
    html:not(.light) .m9g-gotop-btn:hover {
      background: #fbbf24;
      color: #111111;
      border-color: #fbbf24;
    }
  </style>
</head>
<body>
  <div id="progress-bar"></div>
  <div id="cursor-ring" class="cursor-ring"></div>
  <div id="cursor-dot" class="cursor-dot"></div>
  <canvas id="fluid-canvas"></canvas>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <span><span class="g-m">M</span><span class="g-9">9</span><span class="g-g">G</span></span>
        <span class="brand-sep">|</span>
        <span class="brand-sec" data-i18n="blogHeaderBrand">Blog</span>
      </a>
      <div style="display:flex; align-items:center; gap:6px; min-width:0; flex:1; justify-content:flex-end;">
        <nav class="topnav">
          <a href="/vcard/" class="hero-pill-btn hero-pill-github"><span>CV</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
          <a href="/archive/" class="hero-pill-btn hero-pill-github"><span data-i18n="navArchive">Archive</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
          <a href="/blog/" class="hero-pill-btn hero-pill-linkedin"><span data-i18n="navBlog">Blog</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
          <a href="/tutorials/" class="hero-pill-btn hero-pill-github"><span data-i18n="navTutorials">Tutorials</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
          <a href="/" class="hero-pill-btn hero-pill-linkedin"><span data-i18n="navPortfolio">Main Portal</span><span style="font-size:11px;opacity:0.8;">↗</span></a>
        </nav>
        <button class="topbar-btn" id="theme-btn" data-theme-toggle="icon-only" onclick="window.__m9gToggleTheme()" title="Toggle Light / Dark Theme">☀</button>
        <div class="lang-dropdown-wrap" id="lang-dropdown-wrap">
          <button class="topbar-btn" onclick="toggleLangMenu(arguments[0])" aria-label="Select Language">
            <span id="current-lang-label">EN</span>
            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <div class="lang-popup" id="lang-popup">
            <button class="lang-option active" onclick="setLang('en')" data-lang="en"><span>English</span></button>
            <button class="lang-option" onclick="setLang('ko')" data-lang="ko"><span>한국어</span></button>
            <button class="lang-option" onclick="setLang('ja')" data-lang="ja"><span>日本語</span></button>
            <button class="lang-option" onclick="setLang('es')" data-lang="es"><span>Español</span></button>
            <button class="lang-option" onclick="setLang('zh')" data-lang="zh"><span>中文</span></button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <main class="main-wrap">
    <div class="sec-head">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/></svg>
      <h1 class="sec-eyebrow" data-i18n="hubTitle">M9G Technical Research &amp; Engineering Blog</h1>
    </div>
    <p class="sec-sub" data-i18n="hubSub">
      Technical reports, architecture diagrams, and benchmark data on multi-robot TAMP, Vision-Language-Action (VLA) planning, and agentic coding tools.
    </p>

    <div class="sub-bar">
      <div class="sub-bar-left">
