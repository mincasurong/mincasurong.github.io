  <script is:inline>
    window.addEventListener('scroll', function() {
      var doc = document.documentElement;
      var top = doc.scrollTop || document.body.scrollTop;
      var height = doc.scrollHeight - doc.clientHeight;
      var bar = document.getElementById('progress-bar');
      if (bar) bar.style.width = (height > 0 ? (top / height) * 100 : 0) + '%';
    }, { passive: true });

    (function initInteractiveCursor() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var ring = document.getElementById('cursor-ring');
      var dot = document.getElementById('cursor-dot');
      if (!ring || !dot || window.matchMedia('(pointer: coarse)').matches) return;
      var mx = -100, my = -100, rx = -100, ry = -100;
      window.addEventListener('mousemove', function(e) {
        mx = e.clientX; my = e.clientY;
        dot.style.transform = 'translate3d(' + (mx - 3) + 'px,' + (my - 3) + 'px,0)';
      }, { passive: true });
      function tickCursor() {
        if (!document.hidden) {
          rx += (mx - rx) * 0.18;
          ry += (my - ry) * 0.18;
          ring.style.transform = 'translate3d(' + (rx - 16) + 'px,' + (ry - 16) + 'px,0)';
        }
        requestAnimationFrame(tickCursor);
      }
      requestAnimationFrame(tickCursor);
    })();

    (function initFluidCanvas() {
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var canvas = document.getElementById('fluid-canvas');
      if (!canvas) return;
      var ctx = canvas.getContext('2d');
      var width = canvas.width = window.innerWidth;
      var height = canvas.height = window.innerHeight;
      window.addEventListener('resize', function() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      });
      var mouse = { x: -1000, y: -1000 };
      window.addEventListener('mousemove', function(e) {
        mouse.x = e.clientX; mouse.y = e.clientY;
      }, { passive: true });
      var count = Math.min(64, Math.max(28, Math.floor((width * height) / 22000)));
      var particles = [];
      for (var i = 0; i < count; i++) {
        particles.push({
          x: Math.random() * width, y: Math.random() * height,
          vx: (Math.random() - 0.5) * 0.55, vy: (Math.random() - 0.5) * 0.55,
          r: Math.random() * 1.9 + 0.9, gold: i % 3 === 0
        });
      }
      function renderParticles() {
        if (document.hidden) {
          requestAnimationFrame(renderParticles);
          return;
        }
        ctx.clearRect(0, 0, width, height);
        var isLight = document.documentElement.classList.contains('light');
        for (var i = 0; i < particles.length; i++) {
          var p = particles[i];
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > width) p.vx *= -1;
          if (p.y < 0 || p.y > height) p.vy *= -1;
          var dxm = p.x - mouse.x, dym = p.y - mouse.y;
          var distMouse = Math.sqrt(dxm * dxm + dym * dym);
          if (distMouse < 140 && distMouse > 0) {
            p.x += (dxm / distMouse) * 1.25; p.y += (dym / distMouse) * 1.25;
          }
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = p.gold
            ? (isLight ? 'rgba(26, 115, 232, 0.55)' : 'rgba(212, 175, 55, 0.65)')
            : (isLight ? 'rgba(95, 99, 104, 0.35)' : 'rgba(96, 165, 250, 0.45)');
          ctx.fill();
          for (var j = i + 1; j < particles.length; j++) {
            var q = particles[j];
            var dx = p.x - q.x, dy = p.y - q.y;
            var d = Math.sqrt(dx * dx + dy * dy);
            if (d < 130) {
              ctx.beginPath();
              ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y);
              var alpha = (1 - d / 130) * (isLight ? 0.16 : 0.2);
              ctx.strokeStyle = (p.gold || q.gold)
                ? (isLight ? 'rgba(26, 115, 232, ' + alpha + ')' : 'rgba(212, 175, 55, ' + alpha + ')')
                : (isLight ? 'rgba(95, 99, 104, ' + alpha + ')' : 'rgba(148, 163, 184, ' + alpha + ')');
              ctx.lineWidth = 0.75;
              ctx.stroke();
            }
          }
        }
        requestAnimationFrame(renderParticles);
      }
      requestAnimationFrame(renderParticles);
    })();

    function filterFeed(topic, btnEl) {
      document.querySelectorAll('.filter-pill').forEach(function(b) { b.classList.remove('active'); });
      if (btnEl) btnEl.classList.add('active');
      document.querySelectorAll('.showcase-card').forEach(function(card) {
        var t = card.getAttribute('data-topic');
        card.classList.toggle('hidden', topic !== 'all' && t !== topic);
      });
    }

