---
import { getCollection } from 'astro:content';
import ThemeHead from '../../components/ThemeHead.astro';

const publications = (await getCollection('publications')).sort((a, b) => a.data.order - b.data.order);
const patents = (await getCollection('patents')).sort((a, b) => a.data.order - b.data.order);
if (publications.length !== 21) {
  throw new Error(`Expected 21 publications in content collection, got ${publications.length}`);
}
if (patents.length !== 14) {
  throw new Error(`Expected 14 patents in content collection, got ${patents.length}`);
}
---
<!DOCTYPE html>
<html lang="en" class="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Patents, Publications &amp; Research Archive · M9G Engineering Hub</title>
  <link rel="canonical" href="https://mincasurong.github.io/archive/" />
  <meta name="robots" content="index, follow" />
  <meta name="description" content="Engineering and research archive of Minsu Chang, Ph.D. (M9G): 21 peer-reviewed papers, 14 US and KR patents, KFDA-certified SUBAR clinical exoskeleton deployments across 6 hospitals, Google Gemini 3 Seoul Hackathon 1st-Place epilogue, Vertex AI OnBoard notes, and Sogang University LQR and MATLAB control lectures." />
  <ThemeHead />
  <style is:global>
    :root {
      --bg: #ffffff;
      --surface: #f8f9fa;
      --surface-alt: #f1f3f4;
      --bg-elev: rgba(255, 255, 255, 0.94);
      --bg-card: rgba(255, 255, 255, 0.94);
      --bg-code: #0f172a;
      --text: #202124;
      --text-muted: #3c4043;
      --text-dim: #5f6368;
      --border: #dadce0;
      --border-subtle: #e8eaed;
      --accent-blue: #1a73e8;
      --accent-blue-bg: #e8f0fe;
      --accent-emerald: #1a73e8;
      --accent-indigo: #174ea6;
      --accent-amber: #1a73e8;
      --accent-rose: #1a73e8;
      --gold: #1a73e8;
      --gold-dim: #e8f0fe;
      --shadow: 0 4px 20px rgba(32, 33, 36, 0.05);
      --font-sans: 'Inter Variable', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-display: 'Plus Jakarta Sans Variable', 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono Variable', 'JetBrains Mono', ui-monospace, SFMono-Regular, monospace;
    }
    html.dark {
      --bg: #111111;
      --surface: #181818;
      --surface-alt: #222222;
      --bg-elev: rgba(20, 20, 20, 0.92);
      --bg-card: rgba(22, 22, 22, 0.92);
      --bg-code: #09090b;
      --text: #fcfcfb;
      --text-muted: #f1f5f9;
      --text-dim: #cbd5e1;
      --border: #2a2a2a;
      --border-subtle: #222222;
      --accent-blue: #fbbf24;
      --accent-blue-bg: rgba(251, 191, 36, 0.14);
      --accent-emerald: #fbbf24;
      --accent-indigo: #fbbf24;
      --accent-amber: #fbbf24;
      --accent-rose: #fbbf24;
      --gold: #fbbf24;
      --gold-dim: rgba(251, 191, 36, 0.14);
      --shadow: 0 12px 32px rgba(0, 0, 0, 0.45);
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0; padding: 0; width: 100%; max-width: 100%;
      overflow-x: clip; scroll-behavior: smooth;
      font-family: var(--font-sans); background: var(--bg); color: var(--text);
      font-size: 15.5px; line-height: 1.65; -webkit-font-smoothing: antialiased;
    }
    #fluid-canvas {
      position: fixed; inset: 0; width: 100%; height: 100%;
      pointer-events: none; z-index: 0; opacity: 0.7;
    }
    #progress-bar {
      position: fixed; top: 0; left: 0; height: 3px; width: 0%; z-index: 200;
      background: linear-gradient(90deg, #4285f4 0%, #ea4335 33%, #fbbc04 66%, #34a853 100%);
    }
    .cursor-ring, .cursor-dot {
      position: fixed; top: 0; left: 0; pointer-events: none; z-index: 9999;
      border-radius: 50%; display: none; will-change: transform;
    }
    @media (pointer: fine) and (min-width: 1024px) {
      .cursor-ring {
        display: block; width: 34px; height: 34px;
        border: 1.5px solid rgba(26, 115, 232, 0.45);
        background: rgba(212, 175, 55, 0.04);
        transition: width 0.2s cubic-bezier(0.22, 1, 0.36, 1), height 0.2s cubic-bezier(0.22, 1, 0.36, 1), background-color 0.2s ease, border-color 0.2s ease;
      }
      .cursor-ring.hovering {
        width: 52px; height: 52px;
        border-color: rgba(212, 175, 55, 0.75);
        background: rgba(26, 115, 232, 0.08);
      }
      .cursor-dot {
        display: block; width: 7px; height: 7px;
        background: var(--accent-blue);
        transition: opacity 0.15s ease, transform 0.15s ease;
      }
      .cursor-dot.hovering { opacity: 0; }
    }
    h1, h2, h3, h4 { font-family: var(--font-display); letter-spacing: -0.02em; }
    code, pre { font-family: var(--font-mono); }
    a { color: var(--accent-blue); text-decoration: none; }
    img, svg, video, iframe { max-width: 100%; height: auto; display: block; }

    .hero-pill-btn {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 4px 10px; border-radius: 9999px;
      font-size: 12px; font-weight: 600; line-height: 1.2;
      transition: all 0.15s ease; text-decoration: none;
    }
    .hero-pill-btn:hover { transform: translateY(-1px); }
    .hero-pill-github {
      background: rgba(255, 255, 255, 0.07); color: #e8eaed !important;
      border: 1px solid rgba(255, 255, 255, 0.2);
    }
    .hero-pill-github:hover {
      background: rgba(255, 255, 255, 0.16); color: #ffffff !important;
      border-color: rgba(255, 255, 255, 0.4);
    }
    .hero-pill-linkedin {
      background: rgba(251, 191, 36, 0.16); color: #fbbf24 !important;
      border: 1px solid rgba(251, 191, 36, 0.42);
    }
    .hero-pill-linkedin:hover {
      background: #fbbf24; color: #111111 !important; border-color: #fbbf24;
    }
    html.light .hero-pill-github {
      background: #f1f3f4 !important; color: #202124 !important; border-color: #dadce0 !important;
    }
    html.light .hero-pill-linkedin {
      background: #e8f0fe !important; color: #1a73e8 !important; border-color: rgba(26, 115, 232, 0.32) !important;
    }
    .topbar {
      position: sticky; top: 0; z-index: 100;
      background: var(--bg-elev); backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border);
    }
    .topbar-inner {
      max-width: 1080px; margin: 0 auto; padding: 4px 14px; min-height: 42px;
      display: flex; align-items: center; justify-content: space-between; gap: 8px;
    }
    .brand {
      font-family: var(--font-display); font-size: 16px; font-weight: 800; color: var(--text);
      display: flex; align-items: center; gap: 8px; flex-shrink: 0;
    }
    .g-m { color: #4285f4; } .g-9 { color: #ea4335; } .g-g { color: #34a853; }
    .brand-sep { color: var(--border); font-weight: 400; }
    .brand-sec { font-size: 13px; font-weight: 600; color: var(--accent-blue); }
    .topnav {
      display: flex; align-items: center; gap: 4px; font-size: 12px; font-weight: 600;
      color: var(--text-dim); overflow-x: auto; scrollbar-width: none; white-space: nowrap; min-width: 0;
    }
    .topnav::-webkit-scrollbar { display: none; }
    .topnav a { color: var(--text-dim); padding: 4px 7px; line-height: 1.1; border-radius: 6px; }
    .topnav a:hover { color: var(--accent-blue); }
    .topnav a.active-nav { color: var(--accent-blue); font-weight: 700; }
    .topnav a.back-link {
      color: #ffffff; background: #1a73e8; font-weight: 600; padding: 5px 12px; border-radius: 999px; font-size: 12.5px;
    }
    .topbar-btn, .ctrl-btn {
      height: 28px; padding: 0 9px; border-radius: 999px; border: 1px solid var(--border);
      background: var(--surface); color: var(--text); font-family: var(--font-mono);
      font-size: 11px; font-weight: 700; display: inline-flex; align-items: center; gap: 4px; cursor: pointer;
    }
    .topbar-btn:hover, .ctrl-btn:hover { border-color: var(--accent-blue); color: var(--accent-blue); }
    .lang-dropdown-wrap { position: relative; }
    .lang-popup {
      position: absolute; top: calc(100% + 6px); right: 0; min-width: 132px;
      background: var(--bg); border: 1px solid var(--border); border-radius: 10px;
      box-shadow: 0 10px 28px rgba(32, 33, 36, 0.16); padding: 4px; display: none; z-index: 300;
    }
    .lang-popup.open { display: block; }
    .lang-option {
      width: 100%; text-align: left; background: transparent; border: 0; border-radius: 6px;
      padding: 6px 10px; font-size: 12px; font-weight: 600; color: var(--text-dim);
      display: flex; align-items: center; justify-content: space-between; cursor: pointer;
    }
    .lang-option:hover { background: var(--surface); color: var(--text); }
    .lang-option.active { background: var(--accent-blue-bg); color: var(--accent-blue); font-weight: 700; }

    .hero {
      position: relative; z-index: 1;
      max-width: 1200px; margin: 0 auto; padding: 28px 16px 8px;
    }
    .eyebrow {
      display: inline-block; padding: 3px 10px; border-radius: 999px;
      font-family: var(--font-mono); font-size: 11px; font-weight: 700;
      text-transform: uppercase; letter-spacing: 0.05em;
      background: var(--accent-blue-bg); color: var(--accent-blue); margin-bottom: 10px;
    }
    .hero h1 {
      font-size: clamp(1.65rem, 3.8vw, 2.45rem); font-weight: 800; line-height: 1.2; margin: 0 0 12px 0; color: var(--text);
    }
    .gradient-text { color: var(--accent-blue); }
    .hero-sub { font-size: 1.02rem; color: var(--text-dim); max-width: 900px; margin: 0 0 20px 0; line-height: 1.64; }
    .spec-strip {
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 20px;
    }
    .spec-cell {
      background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px;
      transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    }
    .spec-cell:hover { transform: translateY(-3px) translateX(2px); border-color: var(--accent-blue); }
    .spec-label { font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-dim); margin-bottom: 4px; }
    .spec-val { font-family: var(--font-display); font-size: 1.25rem; font-weight: 800; color: var(--accent-blue); }
    .spec-val.green { color: var(--accent-emerald); }
    .spec-val.amber { color: var(--accent-amber); }
    .spec-note { font-size: 11.5px; color: var(--text-dim); margin-top: 2px; }

    .filter-bar {
      display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 8px;
      padding: 8px; background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
    }
    .filter-btn {
      border: 1px solid transparent; background: transparent; color: var(--text-dim);
      font-family: var(--font-sans); font-size: 12.5px; font-weight: 700;
      padding: 7px 13px; border-radius: 8px; cursor: pointer; transition: all 0.15s ease;
    }
    .filter-btn:hover { color: var(--text); background: var(--surface-alt); }
    .filter-btn.active { background: var(--accent-blue); color: #ffffff; }

    .layout {
      position: relative; z-index: 1;
      max-width: 1200px; margin: 0 auto; padding: 20px 16px 80px;
      display: grid; grid-template-columns: minmax(0, 840px) 290px;
      justify-content: space-between; gap: 36px; align-items: start;
    }
    .toc-sidebar {
      position: sticky; top: 70px;
      background: var(--surface); border: 1px solid var(--border);
      border-radius: 12px; padding: 16px; box-shadow: var(--shadow);
    }
    .toc-group-title {
      font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em;
      color: var(--accent-blue); margin: 14px 0 6px; padding-bottom: 4px; border-bottom: 1px solid var(--border);
    }
    .toc-group-title:first-child { margin-top: 0; }
    .toc-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
    .toc-list a {
      display: block; font-size: 12.5px; font-weight: 500; color: var(--text-dim);
      padding: 4px 6px; border-radius: 6px; transition: all 0.15s ease;
    }
    .toc-list a:hover { color: var(--accent-blue); background: var(--accent-blue-bg); }

    .archive-section { margin-bottom: 36px; scroll-margin-top: 72px; }
    .section-card {
      background: var(--bg-card); border: 1px solid var(--border);
      border-radius: 14px; padding: 22px 24px; margin-bottom: 22px;
      box-shadow: var(--shadow);
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.28s ease, border-color 0.25s ease;
    }
    .section-card:hover {
      transform: translateY(-4px) translateX(3px);
      border-color: rgba(26, 115, 232, 0.5);
      box-shadow: 0 14px 32px rgba(26, 115, 232, 0.09);
    }
    .section-badge {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: var(--font-mono); font-size: 11px; font-weight: 700;
      padding: 3px 10px; border-radius: 999px; margin-bottom: 10px;
      background: var(--accent-blue-bg); color: var(--accent-blue);
    }
    .section-badge.emerald { background: #e6f4ea; color: #137333; }
    .section-badge.amber { background: #fef7e0; color: #b06000; }
    .section-badge.indigo { background: var(--accent-blue-bg); color: var(--accent-indigo); }
    .section-card h2 { font-size: 1.4rem; font-weight: 800; margin: 0 0 10px 0; color: var(--text); }
    .section-card h3 { font-size: 1.08rem; font-weight: 700; margin: 20px 0 8px; color: var(--accent-blue); }
    .section-card p { color: var(--text-muted); margin: 0 0 12px 0; font-size: 0.95rem; }

    .pub-list { display: flex; flex-direction: column; gap: 10px; margin-top: 14px; }
    .pub-item {
      padding: 14px 16px; border-radius: 10px; border: 1px solid var(--border);
      background: var(--surface); display: flex; justify-content: space-between;
      align-items: flex-start; gap: 14px;
      transition: transform 0.22s ease, border-color 0.2s ease, background-color 0.2s ease;
    }
    .pub-item:hover {
      border-color: var(--accent-blue); background: var(--bg);
      transform: translateX(4px) translateY(-2px);
    }
    .pub-item.frontier {
      border-left: 3.5px solid var(--gold);
      background: linear-gradient(90deg, var(--gold-dim) 0%, rgba(255, 255, 255, 0.02) 42%);
    }
    html.light .pub-item.frontier {
      border-left: 3.5px solid #1a73e8;
      background: linear-gradient(90deg, #e8f0fe 0%, #ffffff 42%) !important;
    }
    .frontier-badge {
      display: inline-block; font-family: var(--font-mono); font-size: 10px; font-weight: 800;
      padding: 2px 8px; border-radius: 4px; background: var(--gold); color: #0b0d12;
      margin-right: 7px; letter-spacing: 0.04em; text-transform: uppercase; vertical-align: middle;
    }
    html.light .frontier-badge { background: #1a73e8 !important; color: #ffffff !important; }
    .pub-num { font-family: var(--font-mono); font-size: 12px; font-weight: 700; color: var(--accent-blue); min-width: 34px; }
    .pub-body { flex: 1; min-width: 0; }
    .pub-title { font-weight: 700; color: var(--text); font-size: 0.95rem; margin-bottom: 4px; }
    .pub-authors { font-size: 0.84rem; color: var(--text-dim); margin-bottom: 3px; }
    .pub-venue { font-family: var(--font-mono); font-size: 0.76rem; color: var(--accent-emerald); font-weight: 600; }
    .pub-link {
      display: inline-flex; align-items: center; gap: 4px;
      padding: 5px 11px; border-radius: 8px; border: 1px solid var(--border);
      background: var(--bg); color: var(--accent-blue);
      font-family: var(--font-mono); font-size: 11.5px; font-weight: 700; white-space: nowrap; align-self: center;
    }
    .pub-link:hover { background: var(--accent-blue); color: #ffffff; border-color: var(--accent-blue); }

    .video-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: 14px; margin: 14px 0; }
    .video-card {
      background: var(--surface); border: 1px solid var(--border); border-radius: 12px;
      overflow: hidden; display: flex; flex-direction: column;
      transition: transform 0.24s ease, border-color 0.2s ease;
    }
    .video-card:hover { transform: translateY(-4px); border-color: var(--accent-blue); }
    .video-frame { position: relative; width: 100%; padding-top: 56.25%; background: #000; }
    .video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
    .video-body { padding: 12px 14px; }
    .video-title { font-weight: 700; font-size: 0.9rem; color: var(--text); margin-bottom: 4px; }
    .video-desc { font-size: 0.8rem; color: var(--text-dim); }

    .resource-row { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
    .resource-chip {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px; border-radius: 8px; font-size: 12px; font-weight: 600;
      background: var(--accent-blue-bg); border: 1px solid rgba(26, 115, 232, 0.3); color: var(--accent-blue);
    }
    .resource-chip.emerald { background: #e6f4ea; border-color: rgba(30, 142, 62, 0.3); color: #137333; }
    .resource-chip.amber { background: #fef7e0; border-color: rgba(227, 116, 0, 0.3); color: #b06000; }

    .bilingual-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; margin-top: 14px; }
    .bilingual-box { padding: 16px; border-radius: 12px; border: 1px solid var(--border); background: var(--surface); }

    .spec-table { width: 100%; border-collapse: collapse; margin: 14px 0; font-size: 13px; }
    .spec-table th, .spec-table td { padding: 9px 11px; border-bottom: 1px solid var(--border-subtle); text-align: left; }
    .spec-table th { background: var(--surface); font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; color: var(--text-dim); }

    .reveal-on-scroll, .reveal-left, .reveal-right {
      opacity: 0;
      transition: opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1), transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .reveal-on-scroll { transform: translateY(26px); }
    .reveal-left { transform: translateX(-34px) translateY(14px); }
    .reveal-right { transform: translateX(34px) translateY(14px); }
    .reveal-on-scroll.is-visible, .reveal-left.is-visible, .reveal-right.is-visible {
      opacity: 1; transform: translate3d(0, 0, 0);
    }
    @media (prefers-reduced-motion: reduce) {
      .reveal-on-scroll, .reveal-left, .reveal-right { opacity: 1; transform: none; transition: none; }
    }

    footer {
      position: relative; z-index: 1;
      background: var(--surface); border-top: 1px solid var(--border);
      padding: 28px 16px; text-align: center; font-size: 12.5px; color: var(--text-dim);
    }
    @media (max-width: 980px) {
      .layout { grid-template-columns: minmax(0, 1fr); }
      .toc-sidebar { position: static !important; }
    }
    @media (max-width: 640px) {
      .brand-sec, .brand-sep { display: none; }
      .spec-strip { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
      .pub-item { flex-direction: column; }
      .pub-link { align-self: flex-start; }
    }
  
    .m9g-gotop-bar {
      display: flex;
      justify-content: center;
      padding: 18px 16px 8px;
      position: relative;
      z-index: 10;
    }
    .m9g-gotop-btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 9px 20px;
      border-radius: 9999px;
      background: #e8f0fe;
      color: #1a73e8;
      border: 1px solid rgba(26, 115, 232, 0.34);
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      font-size: 12.5px;
      font-weight: 700;
      letter-spacing: 0.03em;
      cursor: pointer;
      transition: all 0.2s cubic-bezier(0.2, 0, 0, 1);
      box-shadow: 0 2px 10px rgba(26, 115, 232, 0.12);
    }
    .m9g-gotop-btn:hover {
      background: #1a73e8;
      color: #ffffff;
      border-color: #1a73e8;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(26, 115, 232, 0.24);
    }
    html.dark .m9g-gotop-btn,
    html:not(.light) .m9g-gotop-btn {
      background: rgba(212, 175, 55, 0.14);
      color: #fbbf24;
      border-color: rgba(212, 175, 55, 0.38);
      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.4);
    }
    html.dark .m9g-gotop-btn:hover,
    html:not(.light) .m9g-gotop-btn:hover {
      background: #fbbf24;
      color: #111111;
      border-color: #fbbf24;
    }
  </style>
</head>
<body>
  <canvas id="fluid-canvas"></canvas>
  <div id="cursor-ring" class="cursor-ring"></div>
  <div id="cursor-dot" class="cursor-dot"></div>
  <div id="progress-bar"></div>

  <header class="topbar">
    <div class="topbar-inner">
      <a href="/" class="brand">
        <span><span class="g-m">M</span><span class="g-9">9</span><span class="g-g">G</span></span>
        <span class="brand-sep">|</span>
        <span class="brand-sec" data-i18n="nav_archive">Research &amp; Archive</span>
      </a>
      <div style="display:flex; align-items:center; gap:6px; min-width:0; flex:1; justify-content:flex-end;">
        <nav class="topnav" style="gap:6px;">
